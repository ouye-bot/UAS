          <mxGeometry x="300" y="20" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="应用层&#xa;飞手工作台 ｜ 审计台 ｜ 机构台 ｜ 公众验证入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="70" width="560" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="svc" value="服务层&#xa;受理门控 ｜ 证明受理验证服务（仅受理与验证，证明计算在用户本机） ｜ 飞行桥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="560" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="crypto" value="密码层&#xa;SM2 椭圆曲线 ｜ SM3 杂凑 ｜ SM4 分组密码 ｜ 门限秘密分享 ｜ 不经意伪随机函数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="230" width="560" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="circuit" value="电路层&#xa;匿名准入电路（19,434 条约束） ｜ 轨迹合规电路（6,157,272 字节证明）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="310" width="560" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="chain" value="链层&#xa;国密联盟链（四节点 PBFT） ｜ 四类合约：登记机构 / 治理方 / 授权服务 / 审计方" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="390" width="560" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="app" target="svc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="svc" target="crypto">
