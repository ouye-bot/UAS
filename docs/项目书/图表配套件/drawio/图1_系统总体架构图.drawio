          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note1" value="要点：证明计算不出用户本机&#xa;链上公开面不载身份字段" style="text;html=1;fontSize=11;fontStyle=1;align=left;fillColor=#FFF9C4;strokeColor=#FBC02D;rounded=1;" vertex="1" parent="1">
